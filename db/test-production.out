SELECT p.pid, p.name, p.brand, p.quantity, p.unit, COUNT(*) AS retailers
FROM Product p JOIN Sells s ON s.pid = p.pid
GROUP BY p.pid, p.name, p.brand, p.quantity, p.unit
ORDER BY retailers DESC, p.pid
LIMIT 10
