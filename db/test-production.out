FROM Product p, Sells s, Vendor r
WHERE p.pid = s.pid AND s.vid = r.vid AND p.name LIKE '%peanut butter%'
  AND ('Pantry' IS NULL OR p.category = 'Pantry') AND ('Jif' IS NULL OR p.brand = 'Jif')
